{
  "name": "gomoku-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "弈间 · 五子棋桌面应用",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run engine:prepare && npm run backend:build && tsc -p tsconfig.electron.json && node scripts/dev.mjs --desktop",
    "dev:web": "npm run backend:build && node scripts/dev.mjs --web",
    "build": "npm run engine:prepare && npm run typecheck && rsbuild build && tsc -p tsconfig.electron.json && npm run backend:build",
    "build:web": "tsc --noEmit && rsbuild build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write src shared electron scripts tests tests-engine *.json *.ts index.html",
    "format:check": "prettier --check src shared electron scripts tests tests-engine *.json *.ts index.html",
    "backend:build": "mvn -q -f backend/pom.xml -DskipTests package",
    "test:backend": "mvn -q -f backend/pom.xml test",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test": "npm run test:backend && npm run test:e2e",
    "engine:prepare": "node scripts/prepare-rapfi.mjs",
    "test:engine": "tsc -p tsconfig.electron.json && node --test tests-engine/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.2.9",
    "i18next": "27.0.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.3.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3"
  }
}
